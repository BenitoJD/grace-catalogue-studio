{
  "name": "grace-studio-desktop",
  "productName": "Grace Studio",
  "version": "1.0.1",
  "private": true,
  "description": "Grace Studio desktop wrapper (Electron) around the Expo web build",
  "author": "Grace Wood Industry",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "npm run bundle:server && electron-builder --mac",
    "build:win": "npm run bundle:server && electron-builder --win",
    "build": "npm run bundle:server && electron-builder",
    "bundle:server": "esbuild ../server/src/boot.mjs --bundle --platform=node --format=esm --target=node24 --external:node:* --outfile=build/server-bundle.mjs"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0"
  }
}
