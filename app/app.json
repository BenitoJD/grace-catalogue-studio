{
  "expo": {
    "name": "Jacob Design Studio",
    "slug": "jacob-design-studio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jacobstudio",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jacobdesignstudio.studio",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jacobdesignstudio.studio",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "themeColor": "#A65E22",
      "backgroundColor": "#FFFFFF",
      "name": "Jacob Design Studio",
      "shortName": "Jacob Design Studio"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "description": "Catalogue studio for Jacob Design Studio. Capture a wardrobe order and render a print ready voucher.",
    "primaryColor": "#A65E22",
    "backgroundColor": "#FFFFFF"
  }
}