# Grace Catalogue Studio: production environment.
#
# Copy this file to .env before running docker compose:
#
#   cp .env.example .env
#   editor .env
#
# docker compose reads .env from the project directory and refuses to start
# without it. Use KEY=value, one per line, with no spaces around the equals
# sign and no quotes unless the value itself contains spaces.
#
# The server reads its values once at startup. The app build variable at the
# bottom is read by Expo at build time and ignored by the server.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# HTTP port the API listens on inside the container. The compose file maps
# this to the same port on the host.
PORT=8787

# Writable directory for the database, rendered PDFs, page images and cached
# template thumbnails. In the container this must stay under /app/data so the
# compose bind mount persists it.
CATALOG_DATA_DIR=/app/data

# Path to the SQLite file. Defaults to catalog.db inside CATALOG_DATA_DIR.
# Only set this to move the database outside the data directory.
CATALOG_DB=/app/data/catalog.db

# Root of the HTML templates and bundled fonts and images. Defaults to the
# repository templates/ directory; the image sets /app/templates.
CATALOG_TEMPLATES_DIR=/app/templates

# WeasyPrint executable used to build PDFs. The image installs it into its own
# virtualenv, so this must point inside /opt/venv. Set it only if you mount a
# different installation.
WEASYPRINT_BIN=/opt/venv/bin/weasyprint

# pdftoppm executable from Poppler, used to rasterise PDF pages for the app
# preview. The Debian package installs it in /usr/bin.
PDFTOPPM_BIN=/usr/bin/pdftoppm

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# Server log verbosity: debug, info, warn or error (any casing is accepted;
# anything else falls back to info). info is right for a small VPS, use debug
# only while tracking down a render problem.
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# HTTP access and limits
# ---------------------------------------------------------------------------

# Comma separated list of browser origins allowed to call the API, for example
# https://catalogue.example.com,https://office.example.com. The web app served
# from the same origin as the API does not need an entry. When unset the server
# defaults to localhost development origins, which would block a browser on a
# real domain. * allows any origin and is only for testing.
CORS_ORIGINS=https://catalogue.example.com

# Requests per minute allowed per client IP across all API reads and writes,
# counted in fixed one minute windows. Values below 1 or non numbers fall back
# to the default of 120 rather than disabling the limit.
RATE_LIMIT_PER_MIN=120

# Render requests per minute allowed per client IP (POST render only).
# Rendering is CPU heavy and queued, so this is deliberately much lower than
# RATE_LIMIT_PER_MIN. Values below 1 fall back to the default of 12.
RENDER_LIMIT_PER_MIN=12

# Delete finished renders older than this many days: the PDF, the page images
# and the renders row. The sweep runs on boot and every 24 hours. 0 keeps
# renders forever (watch disk space on a small VPS).
RENDER_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Language model (optional)
# ---------------------------------------------------------------------------

# Any OpenAI compatible endpoint, for the connection test, the customer note and
# the brochure copy. The studio can also set these at runtime in Settings, and
# values set there win over the environment. The API path used is
# <endpoint>/chat/completions.
#
# For OpenCode Go use the /zen/go path. The server adds the routing header and
# asks reasoning models for a direct answer automatically.
# LLM_ENDPOINT=https://opencode.ai/zen/go/v1

# Model id understood by that endpoint. For OpenCode Zen, deepseek-v4.1-flash is
# a suitable choice.
# LLM_MODEL=deepseek-v4.1-flash

# API key for the endpoint. Stored values take precedence over this. The key is
# never returned by the API and never written to the logs.
# LLM_API_KEY=

# Note drafting requests per minute per IP. Separate from the render budget.
NOTE_LIMIT_PER_MIN=30

# ---------------------------------------------------------------------------
# App build only (the server ignores this variable)
# ---------------------------------------------------------------------------

# Base URL of the API baked into the Expo app and web build. The server ignores
# it. Leave it unset for a same origin web deploy; uncomment and set the public
# domain when building the native app or a web build hosted on another origin.
# EXPO_PUBLIC_API_URL=https://catalogue.example.com
